      <a href="/" class="nav-logo" aria-label="Bomalu - Inicio">
        <img src="/images/logo-color.png" alt="Bomalu" class="logo-img" />
      </a>
      <div class="nav-links">
        <a href="/#experiencia">Experiencia</a>
        <a href="/#restaurante">Restaurante</a>
        <a href="/#habitaciones">Habitaciones</a>
        <a href="/#ubicacion">Ubicación</a>
      </div>
      <div class="nav-right">
        <a href="/en/menu" class="lang-toggle">EN</a>
        <a href={WA_LINK} class="btn btn-primary nav-cta" target="_blank" rel="noopener">Reservar</a>
      </div>
      <button class="nav-hamburger" id="hamburger" aria-label="Menú">
