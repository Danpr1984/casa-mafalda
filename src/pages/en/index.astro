---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Carousel from '../../components/Carousel.astro';

import imgHero      from '../../assets/images/hero-mafalda.jpg';
import imgPool      from '../../assets/images/pool3.jpg';
import imgNature    from '../../assets/images/garden-mafalda1.jpg';

const houseCarouselImgs = [
  '/images/mafalda/pool-beach.jpg',
  '/images/mafalda/pool1.jpg',
  '/images/mafalda/pool2.jpg',
  '/images/mafalda/house-ext.jpg',
  '/images/mafalda/garden1.jpg',
  '/images/mafalda/entrance.jpg',
  '/images/mafalda/lounge1.jpg',
  '/images/mafalda/house1.jpg',
  '/images/mafalda/house3.jpg',
  '/images/mafalda/house4.jpg',
  '/images/mafalda/house6.jpg',
];

const room1Imgs = [
  '/images/mafalda/room1.jpg',
  '/images/mafalda/room2.jpg',
  '/images/mafalda/room3.jpg',
  '/images/mafalda/room4.jpg',
];

const room2Imgs = [
  '/images/mafalda/lounge1.jpg',
  '/images/mafalda/lounge2.jpg',
  '/images/mafalda/diner1.jpg',
  '/images/mafalda/diner2.jpg',
  '/images/mafalda/kitchen.jpg',
];

const room3Imgs = [
  '/images/mafalda/pool-beach.jpg',
  '/images/mafalda/pool1.jpg',
  '/images/mafalda/pool2.jpg',
  '/images/mafalda/garden1.jpg',
  '/images/mafalda/garden2.jpg',
];

const WA_NUMBER  = "50500000000";
const WA_MESSAGE = encodeURIComponent("Hi, I'd like to check availability at Casa Mafalda.");
const WA_LINK    = `https://wa.me/${WA_NUMBER}?text=${WA_MESSAGE}`;
const BOOKING_URL = WA_LINK;
const INSTAGRAM  = "https://instagram.com/casamafalda";
const EMAIL      = "info@casa-mafalda.com";
---

<BaseLayout
  title="Casa Mafalda — El Coco, Nicaragua"
  description="Eco-friendly beachfront house on El Coco beach, South Pacific Nicaragua. 8 guests, private pool, tropical garden and direct access to one of Central America's most beautiful beaches."
  lang="en"
>

<!-- ===================== NAV ===================== -->
<header class="nav">
  <div class="nav-inner">
    <a href="/en/" class="nav-logo">Casa Mafalda</a>
    <nav class="nav-links">
      <a href="#rooms">Rooms</a>
      <a href="#includes">What's included</a>
      <a href="#experience">Experience</a>
      <a href="#location">Location</a>
      <a href={`mailto:${EMAIL}`}>Contact</a>
    </nav>
    <a href="/" class="lang-switch" aria-label="Versión en español">ES</a>
    <a href={BOOKING_URL} class="btn btn-primary nav-cta" target="_blank" rel="noopener">Book Now</a>
    <button class="nav-hamburger" id="hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="nav-mobile" id="nav-mobile">
    <a href={BOOKING_URL} target="_blank" rel="noopener" class="nav-mobile-link">Book Now</a>
    <a href="#rooms" class="nav-mobile-link">Rooms</a>
    <a href="#includes" class="nav-mobile-link">What's included</a>
    <a href="#experience" class="nav-mobile-link">Experience</a>
    <a href="#location" class="nav-mobile-link">Location</a>
    <a href={`mailto:${EMAIL}`} class="nav-mobile-link">Contact</a>
  </div>
</header>

<!-- ===================== HERO ===================== -->
<section class="hero">
  <div class="hero-overlay"></div>
  <Image src={imgHero} alt="Casa Mafalda beachfront — El Coco, Nicaragua" class="hero-bg" width={1600} height={900} loading="eager" />
  <div class="hero-content">
    <p class="hero-tag">El Coco · South Pacific · Nicaragua</p>
    <h1 class="hero-title">A dream hideaway<br />on the Pacific</h1>
    <p class="hero-sub">Eco-friendly home for 8 guests on one of Central America's most beautiful beaches</p>
    <a href={BOOKING_URL} class="btn btn-hero" target="_blank" rel="noopener">Book Now</a>
  </div>
</section>

<!-- ===================== INTRO ===================== -->
<section class="intro section-sm">
  <div class="container">
    <div class="intro-stats">
      <div class="intro-stat"><strong>8</strong><span>guests</span></div>
      <div class="intro-stat"><strong>Direct</strong><span>beach access</span></div>
      <div class="intro-stat"><strong>Pool</strong><span>& garden</span></div>
      <div class="intro-stat"><strong>20 min</strong><span>from San Juan del Sur</span></div>
    </div>
    <p class="intro-body">
      Sitting right across from a quiet beach, Casa Mafalda combines total privacy with complete immersion in nature. Surrounded by trees and birds, large screen windows let the Pacific breeze flow freely, ceiling fans overhead and open spaces designed to feel free. A place where time slows down.
    </p>
  </div>
</section>

<!-- ===================== SPLIT ===================== -->
<section class="split-section">
  <div class="split-content">
    <span class="section-label">Open spaces</span>
    <h2>Designed to be lived in</h2>
    <p>Large screen windows, high ceilings and spaces that open onto the garden. The Pacific breeze flows freely through the entire house. A design that invites togetherness, memory-making and genuine rest.</p>
    <ul class="feature-list">
      <li>Private pool with tropical garden</li>
      <li>Recreational area and parking</li>
      <li>Washing machine (stays over 1 week)</li>
      <li>Full access to the entire house</li>
    </ul>
    <a href={BOOKING_URL} class="btn btn-primary" target="_blank" rel="noopener">Check availability</a>
  </div>
  <div class="split-img">
    <Carousel images={houseCarouselImgs} id="carousel-house-en" alt="Casa Mafalda" aspectRatio="4/3" />
  </div>
</section>

<!-- ===================== ROOMS ===================== -->
<section class="rooms section-sm" id="rooms">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Accommodation</span>
      <h2 class="section-title">Spacious, cool<br />and surrounded by nature</h2>
      <p class="section-sub">Complete house for 8 guests with rooms designed for rest and natural ventilation.</p>
    </div>
    <div class="rooms-grid">
      <div class="room-card">
        <div class="room-card-img">
          <Carousel images={room1Imgs} id="carousel-rooms-en" alt="Bedroom Casa Mafalda" aspectRatio="4/3" />
        </div>
        <div class="room-card-content">
          <h3>Bedrooms</h3>
          <p>Spacious and breezy, with ceiling fans and screen windows for a constant natural Pacific breeze.</p>
          <ul class="room-amenities">
            <li>Ceiling fans</li>
            <li>Screen windows</li>
            <li>Garden access</li>
          </ul>
        </div>
      </div>
      <div class="room-card">
        <div class="room-card-img">
          <Carousel images={room2Imgs} id="carousel-common-en" alt="Common areas Casa Mafalda" aspectRatio="4/3" />
        </div>
        <div class="room-card-content">
          <h3>Living · Dining · Kitchen</h3>
          <p>Spaces integrated with the garden. Fully equipped kitchen with everything you need to prepare your meals comfortably.</p>
          <ul class="room-amenities">
            <li>Fully equipped kitchen</li>
            <li>Indoor dining area</li>
            <li>Outdoor terrace</li>
          </ul>
        </div>
      </div>
      <div class="room-card">
        <div class="room-card-img">
          <Carousel images={room3Imgs} id="carousel-pool-en" alt="Pool and garden Casa Mafalda" aspectRatio="4/3" />
        </div>
        <div class="room-card-content">
          <h3>Garden & pool</h3>
          <p>Private pool surrounded by tropical vegetation. Beach steps away. Living nature from day one.</p>
          <ul class="room-amenities">
            <li>Private pool</li>
            <li>Direct beach access</li>
            <li>Tropical garden</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== AMENITIES ===================== -->
<section class="amenities section-sm" id="includes">
  <div class="container">
    <div class="section-header" style="margin-bottom:48px;">
      <span class="section-label">Everything included</span>
      <h2 class="section-title">Mafalda includes</h2>
      <p class="section-sub">Everything you need for a perfect stay, from day one.</p>
    </div>
    <div class="amenities-grid">
      <div class="amenity-card">
        <div class="amenity-icon">🏊</div>
        <div class="amenity-text">
          <h4>Private pool</h4>
          <p>With tropical garden around it</p>
        </div>
      </div>
      <div class="amenity-card">
        <div class="amenity-icon">🌊</div>
        <div class="amenity-text">
          <h4>Direct beach access</h4>
          <p>Beach just a few steps away</p>
        </div>
      </div>
      <div class="amenity-card">
        <div class="amenity-icon">🌿</div>
        <div class="amenity-text">
          <h4>Tropical garden</h4>
          <p>Surrounded by nature and birds</p>
        </div>
      </div>
      <div class="amenity-card">
        <div class="amenity-icon">🍳</div>
        <div class="amenity-text">
          <h4>Fully equipped kitchen</h4>
          <p>Appliances, utensils and more</p>
        </div>
      </div>
      <div class="amenity-card">
        <div class="amenity-icon">🔥</div>
        <div class="amenity-text">
          <h4>BBQ grill</h4>
          <p>For your evening barbecues</p>
        </div>
      </div>
      <div class="amenity-card">
        <div class="amenity-icon">📶</div>
        <div class="amenity-text">
          <h4>WiFi</h4>
          <p>Connectivity throughout the house</p>
        </div>
      </div>
      <div class="amenity-card">
        <div class="amenity-icon">💨</div>
        <div class="amenity-text">
          <h4>Ceiling fans</h4>
          <p>Natural breeze in every room</p>
        </div>
      </div>
      <div class="amenity-card">
        <div class="amenity-icon">👕</div>
        <div class="amenity-text">
          <h4>Washing machine</h4>
          <p>Available for stays over 1 week</p>
        </div>
      </div>
      <div class="amenity-card">
        <div class="amenity-icon">🚗</div>
        <div class="amenity-text">
          <h4>Private parking</h4>
          <p>Secure, dedicated parking space</p>
        </div>
      </div>
      <div class="amenity-card">
        <div class="amenity-icon">🔑</div>
        <div class="amenity-text">
          <h4>Easy self check-in</h4>
          <p>Flexible arrival access</p>
        </div>
      </div>
      <div class="amenity-card">
        <div class="amenity-icon">🛡️</div>
        <div class="amenity-text">
          <h4>24h security</h4>
          <p>Gated community with permanent guard</p>
        </div>
      </div>
      <div class="amenity-card">
        <div class="amenity-icon">🐢</div>
        <div class="amenity-text">
          <h4>Sea turtle sanctuary</h4>
          <p>Just 5 minutes from the house</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== EXPERIENCE ===================== -->
<section class="experience section-sm" id="experience">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Experience</span>
      <h2 class="section-title">El Coco awaits</h2>
      <p class="section-sub">One of the most pristine and unspoiled beaches on Nicaragua's South Pacific coast.</p>
    </div>
    <div class="experience-grid">
      <div class="exp-item">
        <Image src={imgNature} alt="El Coco beach Nicaragua" width={600} height={400} loading="lazy" />
        <div class="exp-content">
          <h3>El Coco beach</h3>
          <p>Black volcanic sand, Pacific waves and a nature that few beaches in the region have kept intact. Complete privacy.</p>
        </div>
      </div>
      <div class="exp-item">
        <Image src={imgPool} alt="Nature and birds — Casa Mafalda" width={600} height={400} loading="lazy" />
        <div class="exp-content">
          <h3>Living nature</h3>
          <p>Surrounded by trees and constantly visited by different bird species. Wake up to the sound of the forest and the sea.</p>
        </div>
      </div>
      <div class="exp-item">
        <img src="/images/mafalda/sunset1.jpg" alt="Sunset at El Coco Nicaragua" loading="lazy" style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:16px;" />
        <div class="exp-content">
          <h3>Unforgettable sunsets</h3>
          <p>The South Pacific paints the sky in deep orange and gold every evening. A spectacle you simply cannot forget.</p>
        </div>
      </div>
      <div class="exp-item">
        <img src="/images/mafalda/sunset2.jpg" alt="El Coco beach sunset Nicaragua" loading="lazy" style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:16px;" />
        <div class="exp-content">
          <h3>20 minutes from San Juan del Sur</h3>
          <p>20 minutes from San Juan del Sur, and a world away from the everyday. Time here is measured in tides.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== LOCATION ===================== -->
<section class="location section-sm" id="location">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Location</span>
      <h2 class="section-title">El Coco,<br />South Pacific Nicaragua</h2>
    </div>
    <div class="location-details">
      <div class="location-item">📍 El Coco, Rivas, Nicaragua</div>
      <div class="location-item">🚗 20 min from San Juan del Sur</div>
      <div class="location-item">🐢 5 min from the Sea Turtle Sanctuary</div>
      <div class="location-item">✈️ 2h from Managua</div>
    </div>
  </div>
</section>

<!-- ===================== HOUSE RULES ===================== -->
<section class="rules section-sm">
  <div class="container rules-grid">
    <div>
      <h3>House rules</h3>
      <ul class="rules-list">
        <li>⏰ Check-in from 2:00 p.m.</li>
        <li>⏰ Check-out before 12:00 p.m.</li>
        <li>👥 Maximum 8 guests</li>
        <li>🏠 Full access to the entire house</li>
        <li>👗 Washing machine for stays over 1 week</li>
      </ul>
    </div>
    <div>
      <h3>Any questions?</h3>
      <p>Get in touch and we'll be happy to help.</p>
      <a href={WA_LINK} class="btn btn-primary" target="_blank" rel="noopener" style="margin-top:20px;display:inline-flex;align-items:center;gap:8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Message on WhatsApp
      </a>
    </div>
  </div>
</section>

<!-- ===================== CTA ===================== -->
<section class="cta-section">
  <div class="cta-overlay"></div>
  <Image src={imgNature} alt="Casa Mafalda El Coco Nicaragua" class="cta-bg" width={1600} height={600} loading="lazy" />
  <div class="cta-content">
    <h2>Your Pacific escape<br />is waiting for you</h2>
    <p>Pick your dates and make memories that last a lifetime</p>
    <a href={BOOKING_URL} class="btn btn-hero" target="_blank" rel="noopener">Book now</a>
  </div>
</section>

<!-- ===================== FOOTER ===================== -->
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">Casa Mafalda</span>
      <p>El Coco · South Pacific · Nicaragua</p>
    </div>
    <nav class="footer-nav">
      <a href={BOOKING_URL} target="_blank" rel="noopener">Book</a>
      <a href="#rooms">Rooms</a>
      <a href="#experience">Experience</a>
      <a href="#location">Location</a>
    </nav>
    <div class="footer-contact">
      <a href={WA_LINK} target="_blank" rel="noopener">WhatsApp</a>
      <a href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a>
      <a href={`mailto:${EMAIL}`}>Email</a>
    </div>
  </div>
  <p class="footer-copy">made with care from Sweden 🇸🇪 · casa-mafalda.com</p>
</footer>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileNav = document.getElementById('nav-mobile');
  hamburger?.addEventListener('click', () => mobileNav?.classList.toggle('open'));
</script>

</BaseLayout>

<style>
  :root {
    --bg-main:   #FAFAF7;
    --bg-sand:   #F2EFE6;
    --bg-card:   #FFFFFF;
    --accent:    #5C6B47;
    --accent-dk: #3D4D2E;
    --text:      #1C1C1C;
    --muted:     #686868;
    --border:    #E3DDD0;
    --white:     #fff;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Jost', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg-main);
    color: var(--text);
  }

  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap');

  h1, h2, h3, .hero-title, .section-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    letter-spacing: -0.02em;
  }

  img { display: block; max-width: 100%; }
  a { text-decoration: none; color: inherit; }

  .container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .section-sm { padding: 80px 0; }

  .btn {
    display: inline-block; padding: 13px 30px; border-radius: 40px;
    font-family: 'Jost', sans-serif; font-weight: 500; font-size: 14px;
    letter-spacing: 0.04em; cursor: pointer; transition: all 0.25s;
  }
  .btn-sm { padding: 10px 22px; font-size: 13px; margin-top: 16px; }
  .btn-primary { background: var(--accent); color: var(--white); }
  .btn-primary:hover { background: var(--accent-dk); }
  .btn-hero { background: var(--white); color: var(--accent-dk); font-size: 15px; padding: 16px 40px; }
  .btn-hero:hover { background: var(--bg-sand); }

  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(250,250,247,0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner { max-width: 1100px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 28px; height: 64px; }
  .nav-logo { font-family: 'Cormorant Garamond', serif; font-weight: 600; font-size: 20px; color: var(--text); flex: 1; }
  .nav-links { display: flex; gap: 28px; }
  .nav-links a { font-family: 'Jost', sans-serif; color: var(--muted); font-size: 13.5px; font-weight: 400; letter-spacing: 0.02em; }
  .nav-links a:hover { color: var(--text); }
  .nav-cta { padding: 9px 22px; font-size: 13px; }
  .lang-switch { font-size: 11px; font-weight: 600; color: var(--muted); letter-spacing: 0.12em; border: 1.5px solid var(--border); border-radius: 20px; padding: 5px 12px; transition: all 0.2s; font-family: 'Jost', sans-serif; }
  .lang-switch:hover { color: var(--text); border-color: var(--accent); }
  .nav-hamburger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
  .nav-hamburger span { display: block; width: 22px; height: 2px; background: var(--text); border-radius: 2px; }
  .nav-mobile { display: none; background: var(--bg-main); padding: 16px 24px; flex-direction: column; gap: 18px; border-top: 1px solid var(--border); }
  .nav-mobile.open { display: flex; }
  .nav-mobile-link { color: var(--text); font-size: 16px; font-weight: 400; font-family: 'Jost', sans-serif; }

  .hero { position: relative; height: 100vh; min-height: 600px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(20,30,15,0.45) 0%, rgba(20,30,15,0.2) 50%, rgba(20,30,15,0.55) 100%); z-index: 1; }
  .hero-content { position: relative; z-index: 2; text-align: center; color: var(--white); padding: 0 24px; }
  .hero-tag { font-family: 'Jost', sans-serif; font-size: 12px; letter-spacing: 3px; text-transform: uppercase; opacity: 0.8; margin-bottom: 20px; }
  .hero-title { font-size: clamp(2.8rem, 7vw, 5rem); font-weight: 500; line-height: 1.08; margin-bottom: 20px; text-shadow: 0 2px 24px rgba(0,0,0,0.25); }
  .hero-sub { font-family: 'Jost', sans-serif; font-size: clamp(1rem, 2vw, 1.15rem); font-weight: 300; opacity: 0.88; margin-bottom: 36px; max-width: 500px; margin-left: auto; margin-right: auto; }

  .intro { background: var(--bg-main); }
  .intro-stats { display: flex; gap: 56px; justify-content: center; flex-wrap: wrap; margin-bottom: 44px; padding-bottom: 44px; border-bottom: 1px solid var(--border); }
  .intro-stat { text-align: center; }
  .intro-stat strong { display: block; font-family: 'Cormorant Garamond', serif; font-size: 2rem; font-weight: 600; color: var(--accent); }
  .intro-stat span { font-family: 'Jost', sans-serif; font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--muted); }
  .intro-body { max-width: 680px; margin: 0 auto; text-align: justify; text-align-last: center; font-size: 1.05rem; line-height: 1.8; color: var(--muted); font-weight: 300; }

  .split-section { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .split-content { padding: 80px 72px; display: flex; flex-direction: column; justify-content: center; background: var(--bg-sand); }
