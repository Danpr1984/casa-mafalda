---
import BaseLayout from '../../layouts/BaseLayout.astro';

const WA_NUMBER  = "50575325546";
const WA_MESSAGE = encodeURIComponent("Hi, I'd like to make a reservation at Bomalu.");
const WA_LINK    = `https://wa.me/${WA_NUMBER}?text=${WA_MESSAGE}`;
---

<BaseLayout
  title="Menu — Casita de Playa Bomalu | Restaurant Las Peñitas Nicaragua"
  description="Full menu of Casita de Playa Bomalu restaurant and bar. Fresh seafood, breakfasts, handcrafted cocktails and more. Las Peñitas, León, Nicaragua."
  lang="en"
>

  <!-- NAV -->
  <nav class="nav">
    <div class="nav-inner container">
      <a href="/en/" class="nav-logo" aria-label="Bomalu - Home">
        <img src="/images/logo-color.png" alt="Bomalu" class="logo-img" />
      </a>
      <div class="nav-links">
        <a href="/en/#experience">Experience</a>
        <a href="/en/#restaurant">Restaurant</a>
        <a href="/en/#rooms">Rooms</a>
        <a href="/en/#location">Location</a>
      </div>
      <div class="nav-right">
        <a href="/menu" class="lang-toggle">ES</a>
        <a href={WA_LINK} class="btn btn-primary nav-cta" target="_blank" rel="noopener">Book Now</a>
      </div>
      <button class="nav-hamburger" id="hamburger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="nav-mobile" id="nav-mobile">
      <a href="/en/#experience" class="nav-mobile-link">Experience</a>
      <a href="/en/#restaurant" class="nav-mobile-link">Restaurant</a>
      <a href="/en/#rooms" class="nav-mobile-link">Rooms</a>
      <a href="/en/#location" class="nav-mobile-link">Location</a>
      <a href="/menu" class="nav-mobile-link">🇳🇮 Ver en Español</a>
      <a href={WA_LINK} class="btn btn-primary" target="_blank" rel="noopener" style="margin-top:8px;">Book Now</a>
    </div>
  </nav>

  <!-- HERO -->
  <div class="menu-hero">
    <div class="menu-hero-overlay"></div>
    <div class="menu-hero-content container">
      <p class="section-label">Restaurant &amp; Bar</p>
      <h1 class="menu-hero-title">Menu</h1>
      <p class="menu-hero-sub">Fresh cuisine · Pacific seafood · Handcrafted cocktails</p>
    </div>
  </div>

  <!-- MENU CONTENT -->
  <main class="menu-main container">

    <div class="menu-tabs" role="tablist">
      <button class="tab active" data-tab="food">Food</button>
      <button class="tab" data-tab="drinks">Drinks</button>
